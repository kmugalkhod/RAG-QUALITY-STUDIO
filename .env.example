# Local development only. Choose a URL-safe password before first startup.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rag_studio

# Maximum file bytes (default 20 MiB, hard configuration ceiling 100 MiB)
MAX_UPLOAD_BYTES=20971520

# Server-side only. Restart backend and worker after changing embedding settings.
# Fallback key for AUTH_MODE=local (when Organization settings stores none) and oidc.
# AUTH_MODE=clerk never reads it: each organization admin stores the org's own key in
# Organization settings, encrypted with the artifact key boundary (ARTIFACT_ENCRYPTION_*).
OPENROUTER_API_KEY=
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Increment when the same model/endpoint alias changes its embedding behavior.
EMBEDDING_REVISION=1
EMBEDDING_REQUESTS_PER_MINUTE=60

# Explicit OpenRouter chat model, separate from embeddings. No default model. Organization admins
# can also approve models in Organization settings; those are offered alongside this one.
CHAT_MODEL=
# Conservative application budget and ceiling for every model's prompt budget; must not exceed
# the selected model's documented context.
CHAT_CONTEXT_TOKENS=8192
CHAT_MAX_TOKENS=1024

# Additional operator-approved OpenRouter chat IDs; all share CHAT_CONTEXT_TOKENS.
CHAT_MODELS=[]

# Evaluation model is independent of CHAT_MODEL.
EVALUATOR_MODEL=
EVALUATOR_MAX_TOKENS=4096
DATASET_MAX_ROWS=200
DATASET_MAX_BYTES=2097152
RAGAS_DO_NOT_TRACK=true

# Local source-connection vault. Generate a 32-byte key with:
#   openssl rand -base64 32
# Keep old versions present until every stored connection has been rewrapped.
SOURCE_CONNECTIONS_ENABLED=false
SOURCE_CONNECTION_ACTIVE_KEY=local-v1
SOURCE_CONNECTION_KEYS={"local-v1":"replace-with-32-byte-base64-key"}

# Encrypted raw-artifact retention. Required before enabling sensitive-data policy.
# Generate a separate 32-byte key with: openssl rand -base64 32
# Keep old versions until every retained artifact using them has expired or been rewrapped.
ARTIFACT_ENCRYPTION_ENABLED=false
ARTIFACT_ENCRYPTION_MODE=local-keyring
ARTIFACT_ACTIVE_KEY=local-v1
ARTIFACT_KEYS={"local-v1":"replace-with-separate-32-byte-base64-key"}
# OIDC/shared mode must instead select kms or vault and map short immutable
# versions to provider key IDs/names, for example {"prod-v1":"alias/rag-artifacts"}.
ARTIFACT_KEY_REFERENCES={}
ARTIFACT_KMS_REGION=
ARTIFACT_KMS_ENDPOINT_URL=
ARTIFACT_VAULT_ADDRESS=
ARTIFACT_VAULT_TOKEN=
ARTIFACT_VAULT_MOUNT=transit
ARTIFACT_RETENTION_DAYS=30

# Local mode accepts only loopback requests and treats the local user as project owner.
# Shared deployments must use OIDC and a deployment-approved KMS/Vault key boundary;
# never use the local keyring on a shared host.
AUTH_MODE=local
# Clerk development mode requires a server-only secret key, an exact issuer/JWKS
# pair, and authorized frontend origins. Store real values only in ignored .env.
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_ORIGINS=["http://127.0.0.1:5273","http://localhost:5273"]
# Required only when migration 0029 finds existing projects.
LEGACY_PROJECT_ORG_ID=
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_JWKS_URL=
AUTH_OIDC_ALGORITHMS=["RS256"]

# Local-only deployable-answer development. Keep disabled until the isolated
# worker, approved price table and pepper are configured. Never commit a pepper.
DEPLOYED_ANSWERS_ENABLED=false
DEPLOYMENT_LOCAL_KEYS_ENABLED=false
DEPLOYMENT_ACTIVE_PEPPER=
DEPLOYMENT_KEY_PEPPERS={}
DEPLOYMENT_PRICING_VERSION=
DEPLOYMENT_APPROVED_PRICES={}
DEPLOYMENT_KEY_ROTATION_GRACE_MINUTES=15
DEPLOYMENT_KEY_RPM=10
DEPLOYMENT_RPM=30
DEPLOYMENT_ORG_RPM=100
DEPLOYMENT_CONCURRENCY=2
DEPLOYMENT_ORG_CONCURRENCY=10
DEPLOYMENT_QUEUE_CAP=20
DEPLOYMENT_ORG_QUEUE_CAP=100
DEPLOYMENT_GLOBAL_QUEUE_CAP=1000
DEPLOYMENT_ORG_DAILY_USD=5.00
DEPLOYMENT_ORG_MONTHLY_USD=20.00
DEPLOYMENT_MAX_RESERVED_USD_PER_RUN=0.25
DEPLOYMENT_RESULT_RETENTION_DAYS=30

# Website widget, including opt-in public visitors; local loopback only. Use an independent random 32+ byte key.
WIDGET_ENABLED=false
WIDGET_FRAME_ORIGIN=http://127.0.0.1:5274
WIDGET_TOKEN_HASH_KEY=
WIDGET_VISITOR_RPM=5
WIDGET_EXCHANGE_RPM=20
